# credentials — never committed
*.key.json
bq-key.json
.env
.env.*
data/_secrets/

# local scratch and caches
__pycache__/
*.pyc
.venv/
node_modules/
_scratch/
*.log

# licensed / commercial reference data must never enter this public repo.
# Keep any such files outside the repository entirely.
data/_local/

# scraper working artifacts: caches, scratch pulls, downloaded documents
scrapers/**/_scratch/
scrapers/**/_cache*/
scrapers/**/*.pdf
scrapers/**/*.html
scrapers/**/*.xlsx
scrapers/**/*.js
scrapers/**/*.json
scrapers/**/*.xml

# scraper backups and rotated artifacts (the .json rule above misses these)
scrapers/**/*.bak
scrapers/**/*.orig

# scraper checkpoint dirs - resumable state, not deliverables
data/_ckpt_*/

# QueueScope checkpoint markers archived during a re-harvest (state, not source)
data/_ARCHIVED_*/
# raw tariff PDFs cached by the IURC loader
scrapers/tariff_books/

# TIGER All Roads county .zip cache (G122). 69 MB of public-domain Census bulk files, kept
# ON DISK - never deleted - but not committed: they are re-downloadable in ~80s from the URL
# recorded in the in_roads_all registry row, exactly like scrapers/tariff_books/ above.
data/tiger_roads/

# G130 / G150, 2026-08-21: bulk source documents cached by two loaders. Same rule as
# scrapers/**/*.pdf and data/tiger_roads above - the CACHE is not a deliverable, the table built
# from it is. Both are re-fetchable by URL from their registry rows.
# ⚠ ARCHIVED ON DISK, NEVER DELETED - the standing rule about data/ still holds; this only keeps
# 59 MB of state PDFs and a TIGER zip out of the repository.
data/warn_pdfs/
data/tiger_place/
